# Copy to .env and fill in values. Never commit .env.

TELEGRAM_TOKEN=
GEMINI_API_KEY=
ADMIN_ID=

# Admin web panel (required before disabling FLASK_DEBUG)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Any long random string; keeps you logged in across restarts. Required when FLASK_DEBUG=false.
# If unset in dev, a built-in dev key is used (sessions still survive file/reloader restarts).
FLASK_SECRET_KEY=
FLASK_DEBUG=true
FLASK_ENV=development
FLASK_HOST=127.0.0.1
PORT=5000

# Writable folder for SQLite user DB, chat history, settings (required on Render).
# Attach a Persistent Disk on Render and set DATA_DIR to its mount path, e.g. DATA_DIR=/data
# DATA_DIR=/data

# Set to true behind HTTPS so session cookies are not sent over plain HTTP
ADMIN_COOKIE_SECURE=false

# Chat log retention for training / privacy (days). Default 90 (~3 months).
CHAT_HISTORY_RETENTION_DAYS=90

# Append each successful text Q/A to Data_Training.json under Past_Examples (deduplicated, max 2000). Off by default.
# Turn on only if you accept bot answers becoming training data on disk.
AUTO_LEARN_FROM_CHATS=false
